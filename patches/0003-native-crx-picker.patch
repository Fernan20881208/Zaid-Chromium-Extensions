+  protected async onZaidInstallCrxClick_() {
+    if (this.zaidInstalling_ || !this.inDevMode) {
+      return;
+    }
+    this.zaidInstalling_ = true;
+    this.zaidInstallError_ = '';
+    try {
+      const installed = await sendWithPromise<boolean>('zaidInstallCrx');
+      if (installed) {
+        const toastManager = getToastManager();
+        toastManager.duration = TOAST_DURATION_MS;
+        toastManager.show(this.i18n('toolbarLoadUnpackedDone'));
+      }
+    } catch (error) {
+      this.zaidInstallError_ = String(error);
+    } finally {
+      this.zaidInstalling_ = false;
+    }
